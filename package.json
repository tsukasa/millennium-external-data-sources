{
  "name": "io.tsukasa.external-data-sources",
  "version": "0.1.15",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@steambrew/starlight": "1.1.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "1.3.11",
    "@types/jsdom": "21.1.7",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0"
  },
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "test:lua": "lua tests/backend.test.lua",
    "locales": "bun scripts/generate-locales.ts",
    "dev": "bun run locales && starlight watch",
    "build": "bun run test && starlight pack",
    "relbuild": "bun run test && bun -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && starlight pack --of \"dist/\" --release",
    "prepare": "bun run locales && starlight lsp",
    "check": "bun run locales && tsc --noEmit",
    "test": "bun run locales && bun test"
  },
  "type": "module"
}