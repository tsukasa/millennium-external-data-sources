{
  "name": "io.tsukasa.millennium.external-data-sources",
  "version": "0.0.2",
  "devDependencies": {
    "@steambrew/starlight": "1.1.6",
    "@types/bun": "1.3.11",
    "@types/jsdom": "21.1.7",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "jsdom": "^30.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "scripts": {
    "locales": "bun scripts/generate-locales.ts",
    "dev": "bun run locales && starlight watch",
    "build": "bun run test && bun -e \"require('node:fs').mkdirSync('dist', { recursive: true })\" && starlight pack",
    "prepare": "bun run locales && starlight lsp",
    "check": "bun run locales && tsc --noEmit",
    "test": "bun run locales && bun test"
  },
  "type": "module"
}
